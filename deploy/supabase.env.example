# Set these on the Flask host. Never include in browser code or commit real values.
DATABASE_URL=postgresql://COPY_SESSION_POOLER_CONNECTION_FROM_SUPABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_BUCKET=inventory-private
SESSION_SECRET=COPY_EXISTING_SESSION_KEY_FILE_CONTENT
PASSWORD_VAULT_KEY=COPY_EXISTING_PASSWORD_VAULT_KEY_FILE_CONTENT
INVENTORY_DATA=/tmp/travelicious-cache
HTTPS=1
TZ=Asia/Kolkata
