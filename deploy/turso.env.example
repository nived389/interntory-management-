# Server-only secrets. Keep real values in hosting environment settings.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_DATABASE_TOKEN
SESSION_SECRET=COPY_EXISTING_SESSION_KEY_VALUE
PASSWORD_VAULT_KEY=COPY_EXISTING_PASSWORD_VAULT_KEY_VALUE
INVENTORY_DATA=/tmp/travelicious-cache
HTTPS=1
TZ=Asia/Kolkata
# Remove DATABASE_URL when switching from Supabase.
